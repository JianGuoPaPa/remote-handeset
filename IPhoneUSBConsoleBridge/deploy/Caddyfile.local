{
	admin 127.0.0.1:2019
	auto_https disable_redirects
	https_port 18443
	skip_install_trust
	servers {
		protocols h1 h2
	}

	log default {
		output file {$CADDY_RUNTIME_LOG} {
			mode 0600
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			request>uri delete
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>headers>X-CSRF-Token delete
			resp_headers>Set-Cookie delete
		}
		level INFO
	}
}

https://192.168.31.112:18443 {
	bind 192.168.31.112
	tls internal

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'none'; worker-src 'self'; connect-src 'self'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	log {
		output file {$CADDY_ACCESS_LOG} {
			mode 0600
			roll_size 25MiB
			roll_keep 7
			roll_keep_for 168h
		}
		format filter {
			request>uri delete
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>headers>X-CSRF-Token delete
			resp_headers>Set-Cookie delete
		}
	}

	reverse_proxy http://127.0.0.1:18765 {
		flush_interval -1
		stream_timeout 24h
		stream_close_delay 5m
		transport http {
			dial_timeout 2s
			response_header_timeout 10s
		}
	}
}
