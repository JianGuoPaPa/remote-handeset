# 示例；不要直接用于生产。不要照搬现有 Mac 的设备/网络状态。
SITE_ID=site2
ANDROID_SERIAL_1=REPLACE_WITH_FIRST_NEW_SERIAL
ANDROID_SERIAL_2=REPLACE_WITH_SECOND_NEW_SERIAL
LOCAL_GATEWAY_ADDR=127.0.0.1:8079
LOCAL_PREVIEW_ADDR=127.0.0.1:8080
# 现网 18079 正在使用；新端口必须在香港现场重新检查并独立授权。
HK_REVERSE_PORT=REPLACE_WITH_NEW_UNUSED_PORT
PUBLIC_ORIGIN=https://REPLACE_WITH_SITE2_ORIGIN
# PortalAPI 要求 WSS 与 PUBLIC_ORIGIN 的主机和端口一致。
# 新站点应生成新的 origin secret、Portal 登录密码和计算器解锁密码。
